.DEFAULT_GOAL := all
.PHONY: all project walletkit clean distclean vendor-js vendor-js-upgrade

# Third-party JS injected into dapp pages (Resources/Browser/vendor/), each
# generated by an npm package under Scripts/ from its pinned versions.
VENDOR_JS_DIRS := Scripts/sui-sdk Scripts/tronweb
NPM_FLAGS := --ignore-scripts --no-audit --no-fund
	
all: test

# Keeps the generated project and the WalletKit xcframework.
clean:
	@mise x tuist -- tuist clean

# Also drops the project and rebuilds WalletKit from scratch.
distclean: clean
	$(MAKE) -C WalletKit distclean
	@rm -rf Derived *.xcodeproj *.xcworkspace
	@rm -rf WalletKit/Derived WalletKit/*.xcodeproj WalletKit/*.xcworkspace

test: ReefrWallet.xcworkspace
	@echo "==> Running Swift tests"
	@mise x tuist -- tuist test --skip-ui-tests --no-upload --test-targets ReefrWalletTests-macOS -- \
		-destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=-

# Regenerate every vendor/*.js from the pinned package-lock.json.
vendor-js:
	@for dir in $(VENDOR_JS_DIRS); do \
		echo "==> Building $$dir"; \
		(cd $$dir && npm ci $(NPM_FLAGS) && npm run build --silent) || exit 1; \
	done

# Bump every vendored package to its latest release, then regenerate.
vendor-js-upgrade:
	@for dir in $(VENDOR_JS_DIRS); do \
		echo "==> Upgrading $$dir"; \
		(cd $$dir && npm install --save-exact $(NPM_FLAGS) $$(node -p "const p = require('./package.json'); Object.keys({ ...p.dependencies, ...p.devDependencies }).map((n) => n + '@latest').join(' ')")) || exit 1; \
	done
	@$(MAKE) vendor-js

versions:
	Scripts/make_versions.sh

# Forces a WalletKit rebuild; `workspace` only builds it when missing.
walletkit:
	$(MAKE) -C WalletKit spm

workspace: Tuist/ProjectDescriptionHelpers/Project+Version.swift WalletKit/Frameworks/WalletKit.xcframework
	@echo "==> Generating Xcode project"
	@mise x tuist -- tuist install
	@mise x tuist -- tuist generate --no-open

ReefrWallet.xcworkspace: workspace

Tuist/ProjectDescriptionHelpers/Project+Version.swift: versions

WalletKit/Frameworks/WalletKit.xcframework:
	$(MAKE) walletkit
